# Copy to .env and fill in values for local development.
# DATABASE_URL is the only var certcoach code reads at runtime.
# Port 5433 avoids conflict with a local Postgres installation on 5432
DATABASE_URL=postgresql://certcoach:certcoach@localhost:5433/certcoach

# These match docker-compose.yml defaults — change only if you override them there.
POSTGRES_DB=certcoach
POSTGRES_USER=certcoach
POSTGRES_PASSWORD=certcoach

# ai-core gateway (internal model gateway, OpenAI-compatible)
AICORE_BASE_URL=http://127.0.0.1:3030/v1
AICORE_API_KEY=

# internal model gateway direct credentials (used for rerank — not routed via local proxy)
AICORE_DIRECT_BASE_URL=https://api.internal-model-gateway.example.com
AICORE_AUTH_URL=https://<subdomain>.authentication.internal-model-gateway.example.com
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_RESOURCE_GROUP=default

# Arize Phoenix tracing (optional — omit to disable tracing)
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:4317

